# GAMA-L demonstration - pull real customers from erp, filter, remember

# 1) SQL query (our sales database) -> table
t := sql("SELECT TOP 5 konto, naziv, mjesto FROM customers WHERE konto LIKE '2%'")

# 2) pipe: filter (have a name) then select fields
fl := t | filter naziv | select konto, naziv

# 3) count rows
n := fl | count

# 4) AI says something about it
thought := ask local "Anything interesting about customers from the GAMA TRADE database? Briefly count "

# 5) memory - remember what we did
remember "gamal_report" = "pulled N customer rows from erp"

# 6) HITL - ask the user before finishing
confirm := wait user "Show the report? (yes/no)"

# 7) notify
notify email to: "user@gmail.com" subject: "GAMA-L demo" "GAMA-L transpiler works: N=..."
