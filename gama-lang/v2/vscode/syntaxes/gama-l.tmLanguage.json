{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GAMA-L",
  "scopeName": "source.gama-l",
  "fileTypes": [
    "gm"
  ],
  "patterns": [
    {
      "name": "comment.line.number-sign.gama-l",
      "match": "#.*$"
    },
    {
      "name": "meta.import.alias.gama-l",
      "match": "(\\bimport)\\s+(\"[^\"]*\")\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.import.gama-l"
        },
        "2": {
          "name": "string.quoted.double.gama-l"
        },
        "3": {
          "name": "keyword.control.as.gama-l"
        },
        "4": {
          "name": "entity.name.namespace.gama-l"
        }
      }
    },
    {
      "name": "string.quoted.double.gama-l",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gama-l",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.gama-l",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.gama-l",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.gama-l",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "meta.pipe.gama-l",
      "match": "(\\|)\\s*(filter|select|sum|limit|count|map)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.pipe.gama-l"
        },
        "2": {
          "name": "support.function.pipe-stage.gama-l"
        }
      }
    },
    {
      "name": "meta.function.lambda.gama-l",
      "begin": "\\b(fn)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.fn.gama-l"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.gama-l"
        }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.end.gama-l"
        }
      },
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.parameter.gama-l"
            },
            "2": {
              "name": "punctuation.separator.gama-l"
            },
            "3": {
              "name": "support.type.gama-l"
            }
          }
        },
        {
          "name": "keyword.operator.assignment.gama-l",
          "match": "="
        },
        {
          "name": "constant.numeric.gama-l",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "punctuation.separator.gama-l",
          "match": ","
        }
      ]
    },
    {
      "match": "(\\bfn|\\bmake)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.fn.gama-l"
        },
        "2": {
          "name": "entity.name.function.gama-l"
        }
      }
    },
    {
      "match": "(\\blet)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.let.gama-l"
        },
        "2": {
          "name": "variable.other.gama-l"
        }
      }
    },
    {
      "match": "(\\bprove)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
      "captures": {
        "1": {
          "name": "keyword.control.prove.gama-l"
        },
        "2": {
          "name": "entity.name.type.proof.gama-l"
        }
      }
    },
    {
      "name": "support.class.constructor.gama-l",
      "match": "\\b(Ok|Err)\\b"
    },
    {
      "name": "variable.language.wildcard.gama-l",
      "match": "\\b_\\b"
    },
    {
      "match": "(\\bwait)\\s+(user)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.wait.gama-l"
        },
        "2": {
          "name": "keyword.other.user.gama-l"
        }
      }
    },
    {
      "name": "constant.language.gama-l",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "support.type.gama-l",
      "match": "\\b(Int|Decimal|Text|Bool|List|Table|Result|Json|Null|Any|Function)\\b"
    },
    {
      "name": "support.function.builtin.gama-l",
      "match": "\\b(sql|ask|wait_user|sql_write|mail|len|text|number|remember|recall|round|unwrap|unwrap_or|is_ok|is_err|split|join|contains|trim|upper|lower|replace|starts_with|ends_with|keys|values|has)\\b"
    },
    {
      "name": "keyword.control.gama-l",
      "match": "\\b(let|fn|make|if|else|return|match|prove|verify|print|effects|filter|select|sum|limit|count|map|in|import|as|use|wait|for|while|break|continue)\\b"
    },
    {
      "name": "keyword.operator.try.gama-l",
      "match": "\\?"
    },
    {
      "name": "keyword.operator.gama-l",
      "match": "==|!=|<=|>=|&&|\\|\\||:=|->|\\||[+*/%!<>=]|-"
    },
    {
      "name": "meta.function-call.namespaced.gama-l",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.namespace.gama-l"
        },
        "2": {
          "name": "entity.name.function.call.gama-l"
        }
      }
    },
    {
      "name": "entity.name.function.call.gama-l",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
    },
    {
      "name": "punctuation.gama-l",
      "match": "[{}()\\[\\],:;]"
    }
  ]
}
