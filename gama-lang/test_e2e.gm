# GAMA-L end-to-end test (bezbedan: SQL + pipe, bez slanja/HITL)
t := sql("SELECT TOP 3 konto, naziv, mjesto FROM kupdob WHERE konto LIKE '2%'")
iz := t | select konto, naziv
n := iz | broj
misli := ask local "Kratko: koliko kupaca sam upravo povukao iz baze?"
remember "gamal_test" = "probao end-to-end"
pokaz := recall "gamal_test"